#!/usr/bin/env bash
# Pull the latest JPCERTCC Windows symbol tables for Volatility 3.
#
# The repo is cloned at build time and symlinked into Volatility 3's
# symbols/windows directory, so a pull is all an update needs.
set -euo pipefail

REPO=/opt/tools/Windows-Symbol-Tables

if [[ ! -d "$REPO/.git" ]]; then
    echo "update-vol3-symbols: $REPO is missing; rebuild or re-run the tools role" >&2
    exit 1
fi

count() { find "$REPO/symbols/windows" -name '*.json.xz' | wc -l; }

before=$(count)
git -C "$REPO" pull --ff-only --quiet
after=$(count)

echo "JPCERTCC Windows symbol tables: $before -> $after ($(git -C "$REPO" log -1 --format='%h %cs'))"
