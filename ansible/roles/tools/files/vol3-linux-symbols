#!/usr/bin/env python3
"""Fetch the Linux ISF a memory dump needs from Abyss-W4tcher/volatility3-symbols.

The full repo is ~31 GB, so nothing is bundled. This reads the kernel banner
from the dump, looks it up in the repo's banner index, and downloads only the
matching ISF into Volatility 3's symbols/linux directory. After that the dump
analyses offline.

Usage: vol3-linux-symbols <memory-dump>
       vol3-linux-symbols --banner 'Linux version ...'
"""
import json
import os
import subprocess
import sys
import urllib.request

import volatility3.symbols

REPO_RAW = "https://github.com/Abyss-W4tcher/volatility3-symbols/raw/master"
SYMBOLS_DIR = os.path.join(os.path.dirname(volatility3.symbols.__file__), "linux")


def banners_from_dump(path):
    out = subprocess.run(
        ["vol", "-q", "-r", "json", "-f", path, "banners.Banners"],
        check=True, capture_output=True, text=True,
    ).stdout
    return {row["Banner"].strip() for row in json.loads(out)}


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--banner":
        banners = {sys.argv[2].strip()}
    elif len(sys.argv) == 2 and not sys.argv[1].startswith("-"):
        banners = banners_from_dump(sys.argv[1])
    else:
        sys.exit(__doc__.split("\n\n", 2)[2].strip())

    if not banners:
        sys.exit("vol3-linux-symbols: no Linux banner found in dump")

    with urllib.request.urlopen(f"{REPO_RAW}/banners/banners_plain.json") as r:
        index = {k.strip(): v for k, v in json.load(r).items()}

    found = False
    for banner in sorted(banners):
        print(f"banner: {banner}")
        for isf in index.get(banner, []):
            found = True
            dest = os.path.join(SYMBOLS_DIR, os.path.basename(isf))
            if os.path.exists(dest):
                print(f"  have  {dest}")
                continue
            urllib.request.urlretrieve(f"{REPO_RAW}/{isf}", dest)
            print(f"  got   {dest}")

    if not found:
        sys.exit("vol3-linux-symbols: no ISF for this kernel; generate one with dwarf2json")


if __name__ == "__main__":
    main()
